# =============================================================================
# JobHunter backend — example .env
# Copy this file to `.env` and fill in your own values.
# No key is required: the onboarding wizard lets you pick local Ollama, a cloud
# provider (paste the key there or here) or no AI at all.
# =============================================================================

# ---- LLM API keys ----
# Get one at https://console.anthropic.com (recommended).
# Leave empty if you only want to use a local LLM via Ollama.
ANTHROPIC_API_KEY=

# Optional: Google Gemini as a fallback provider
GEMINI_API_KEY=

# Optional: Local Ollama (no API key needed)
OLLAMA_BASE_URL=http://localhost:11434

# ---- LLM routing (which provider tries first per task tier) ----
LLM_SCORING_TIER=anthropic-haiku,gemini-flash,ollama-qwen
LLM_GENERATION_TIER=anthropic-sonnet,gemini-pro,ollama-qwen
LLM_MESSAGING_TIER=anthropic-haiku,gemini-flash,ollama-qwen

# ---- Models per slot (defaults shown) ----
ANTHROPIC_SCORING_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_GENERATION_MODEL=claude-sonnet-4-6
GEMINI_SCORING_MODEL=gemini-2.5-flash
GEMINI_GENERATION_MODEL=gemini-2.5-pro
# Must be downloaded first:  ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b

# ---- Database (SQLite by default — zero config) ----
DATABASE_URL=sqlite:///./jobhunter.db

# ---- Scheduler ----
SCRAPE_INTERVAL_HOURS=6
ENABLE_SCHEDULER=true
# IANA timezone for the weekly jobs (posts on Sunday 18:00).
SCHEDULER_TIMEZONE=Europe/Madrid
# Language of auto-generated content (LinkedIn posts, connection notes): es | en
CONTENT_LANGUAGE=es

# ---- Scoring ----
MIN_SCORE_FOR_PREPARE=70

# ---- Paths ----
DATA_DIR=./data
CV_MASTER_PATH=./app/data/cv_master.json
CV_TEMPLATE_PATH=./app/data/cv_template.typ
# Optional: export a copy of every generated CV/cover to this folder in a
# human-readable structure (YYYY-MM-DD/{Company}_job{id}/cv.pdf ...).
# Absolute path. Leave empty to disable.
# Example: CVS_OUT_DIR=/Users/you/Documents/JobHunter-CVs
CVS_OUT_DIR=

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional: lock the API down to ONLY your JobHunter Chrome extension.
# Find the ID at chrome://extensions (Developer mode). If left empty, any
# installed chrome-extension:// can call the local API.
CHROME_EXTENSION_ID=

# ---- Logging ----
LOG_LEVEL=info

# =============================================================================
# Feature flags
# Set to "false" to hide a feature in the dashboard.
# Useful if you only want the job-search core without the LinkedIn helper.
# =============================================================================
ENABLE_POST_GENERATION=true
ENABLE_IMAGE_GENERATION=true
ENABLE_COMMENT_SUGGESTIONS=true
ENABLE_TRENDING_NEWS=true

# ---- Scrapers / plataformas ----
# Adzuna: la mejor cobertura por pais (ES, GB, DE, FR, NL, IT...).
# Clave GRATUITA en https://developer.adzuna.com — sin ella, Adzuna se
# autodesactiva y no aparece como plataforma activa.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Tope de ofertas puntuadas con LLM por ciclo de scrape. Cada oferta nueva = 1
# llamada. Las que pasen del tope se guardan sin puntuar y se puntuan despues.
# 0 = sin limite (cuidado con el gasto).
MAX_SCORED_JOBS_PER_RUN=150
